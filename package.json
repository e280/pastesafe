{
	"private": true,
	"name": "@e280/pastesafe",
	"version": "0.1.5",
	"description": "secrets in public",
	"license": "MIT",
	"author": "Chase Moskal <chasemoskal@gmail.com>",
	"type": "module",
	"scripts": {
		"start": "node x/server.js",
		"build": "rm -rf x && mkdir x && tsc && scute -v",
		"dev": "octo 'tsc -w' 'scute -wv' 'node --watch x/test.js' 'hottie x'",
		"test": "node x/test.js",
		"count": "find s -path '*/_archive' -prune -o -name '*.ts' -exec wc -l {} +"
	},
	"dependencies": {
		"@e280/authlocal": "^0.3.9",
		"@e280/shiny": "^0.1.0",
		"@e280/sly": "^0.4.11",
		"@e280/strata": "^0.5.6",
		"@e280/stz": "^0.4.11",
		"lit": "^3.3.3",
		"micromark": "^4.0.3",
		"micromark-extension-gfm": "^3.0.0"
	},
	"devDependencies": {
		"@e280/hottie": "^0.1.7",
		"@e280/octo": "^0.1.7",
		"@e280/science": "^0.1.14",
		"@e280/scute": "^0.5.3",
		"typescript": "^7.0.2"
	},
	"allowScripts": {
		"esbuild@0.28.2": true
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/e280/pastesafe.git"
	},
	"bugs": {
		"url": "https://github.com/e280/pastesafe/issues"
	},
	"homepage": "https://github.com/e280/pastesafe#readme",
	"keywords": [
		"encryption",
		"e2ee",
		"end to end encryption",
		"ecryption"
	]
}
